{
  "name": "expo-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "node scripts/ensure-younify-ios-framework.cjs",
    "start": "bunx rork start -p ys290igcrg72o48csk4or --tunnel",
    "start-web": "bunx rork start -p ys290igcrg72o48csk4or --web --tunnel",
    "start-web-dev": "DEBUG=expo* bunx rork start -p ys290igcrg72o48csk4or --web --tunnel",
    "expo-go": "expo start",
    "expo-dev": "expo start --dev-client",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:preview:android": "eas build --profile preview --platform android",
    "eas:build:preview:ios": "eas build --profile preview --platform ios",
    "eas:build:production:ios": "eas build --profile production --platform ios",
    "eas:submit:ios": "eas submit --profile production --platform ios --latest",
    "eas:build:dev": "eas build --profile development",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "dev": "bash scripts/run-ios-with-younify-auth.sh",
    "ios:sim": "bash scripts/run-ios-with-younify-auth.sh",
    "ios:sim:metro-only": "node scripts/fix-ios-sim-deep-links.cjs && open -a Simulator && REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 EXPO_USE_LOCALHOST=1 npx expo start --dev-client --localhost --port 8081 --ios",
    "ios:sim:refresh": "node scripts/fix-ios-sim-deep-links.cjs && open -a Simulator && REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 EXPO_USE_LOCALHOST=1 npx expo start --dev-client --localhost --port 8081 --clear --ios",
    "ios:sim:fix-links": "node scripts/fix-ios-sim-deep-links.cjs",
    "ios:sim:full": "bash scripts/run-ios-with-younify-auth.sh",
    "younify-auth": "node backend/younify-auth/server.js",
    "api:public": "tsx backend/serve.ts",
    "smoke:football": "node scripts/smoke-football-api.mjs",
    "smoke:events": "node scripts/smoke-events-api.mjs",
    "test": "node --import tsx --test utils/__tests__/*.test.ts",
    "test:football": "node --import tsx --test utils/__tests__/football*.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hono/node-server": "^1.19.14",
    "@hono/trpc-server": "^0.4.2",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@rork-ai/toolkit-sdk": "^0.2.54",
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/react-query": "^5.90.6",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "dotenv": "^17.4.2",
    "expo": "^54.0.22",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.10",
    "expo-blur": "~15.0.7",
    "expo-calendar": "^55.0.9",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "^55.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.13",
    "expo-router": "~6.0.14",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.10",
    "hono": "^4.11.9",
    "lucide-react-native": "^0.475.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "^0.8.1",
    "react-native-younify-connect-sdk": "file:./vendor/react-native-younify-connect-sdk-1.0.3.tgz",
    "superjson": "^2.2.6",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "eas-cli": "^16.32.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
